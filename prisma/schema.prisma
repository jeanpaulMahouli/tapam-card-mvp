generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  username            String    @unique
  passwordHash        String
  email               String?   @unique
  phone               String?   @unique
  role                String    @default("USER")
  status              String    @default("ACTIVE")
  mustChangePassword  Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  profile   Profile?
  card      Card?

  @@index([email])
  @@index([phone])
}

model Card {
  id            String    @id @default(cuid())
  cardNumber    String    @unique
  slug          String    @unique
  type          String    @default("EXPRESS")
  status        String    @default("PENDING")
  userId        String?
  publicUrl     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  activatedAt   DateTime?

  user        User?     @relation(fields: [userId], references: [id])
  views       CardView[]
  profile     Profile?

  @@index([userId])
  @@index([cardNumber])
  @@index([slug])
}

model Profile {
  id          String    @id @default(cuid())
  userId      String    @unique
  firstName   String
  lastName    String
  photo       String?
  jobTitle    String
  company     String
  bio         String?
  phone       String
  whatsapp    String?
  email       String
  website     String?
  linkedin    String?
  facebook    String?
  instagram   String?
  tiktok      String?
  location    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id])
  services  Service[]
}

model Service {
  id          String    @id @default(cuid())
  profileId   String
  name        String
  description String?
  position    Int       @default(0)

  profile     Profile   @relation(fields: [profileId], references: [id])

  @@index([profileId])
  @@index([position])
}

model CardView {
  id        String    @id @default(cuid())
  cardId    String
  createdAt DateTime  @default(now())
  userAgent String?
  referrer  String?

  card      Card      @relation(fields: [cardId], references: [id])

  @@index([cardId])
}

model Design {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  previewImage  String
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Rôles possibles
enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

// Statuts possibles pour une carte
enum CardStatus {
  PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
}

// Types de cartes
enum CardType {
  EXPRESS
  CUSTOM
  BUSINESS
}